<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout XML pour la page d'accueil de l'application SamaCité
  Compatible avec Copilot / Android Studio
  Structure générique basée sur un écran d'accueil classique :
  - AppBar avec titre et icône profil
  - Barre de recherche
  - Carte affichant les signalements récents
  - Bouton flottant pour ajouter un signalement
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top AppBar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:padding="12dp"
        app:title="SamaCité"
        app:titleTextColor="@color/black"
        app:menu="@menu/home_menu" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="64dp"
        android:padding="16dp">

        <!-- Search bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Rechercher un incident..."
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Section title -->
        <TextView
            android:id="@+id/tvRecentReportsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signalements récents"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- RecyclerView list of reports -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReports"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="80dp" />

    </LinearLayout>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Ajouter un signalement"
        android:src="@drawable/ic_add"
        app:layout_anchorGravity="bottom|end"
        app:backgroundTint="@color/colorPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
