<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout XML de la page de création d'un signalement dans SamaCité
  Compatible Android Studio / Copilot
  Contient :
  - Image / capture du problème
  - Champs texte : titre, localisation, description
  - Sélecteur de catégorie
  - Bouton d'envoi
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title -->
        <TextView
            android:id="@+id/tvSignalementTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nouveau Signalement"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginBottom="20dp" />

        <!-- Image preview / camera -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#EEEEEE"
            android:foregroundGravity="center"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/imgCapture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Photo du signalement" />

            <TextView
                android:id="@+id/tvAddPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajouter une photo"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="#55000000"
                android:padding="6dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Category selector -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:startIconDrawable="@drawable/ic_category">

            <AutoCompleteTextView
                android:id="@+id/etCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Catégorie"
                android:inputType="text"
                android:contentDescription="Liste de catégories" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Localisation -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLocation"
            app:startIconDrawable="@drawable/ic_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Localisation"
                android:inputType="text"
                android:contentDescription="Lieu du signalement" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescription"
            app:startIconDrawable="@drawable/ic_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Description de l'incident"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:contentDescription="Description du signalement" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Submit button -->
        <Button
            android:id="@+id/btnSubmitReport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Envoyer le signalement"
            android:textAllCaps="false"
            android:contentDescription="Bouton d'envoi du signalement" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar / Header -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nouveau Signalement"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="24dp"/>

        <!-- Type de signalement -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type de signalement">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Localisation (adresse ou selection sur carte) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Localisation">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bouton Ouvrir Carte -->
        <Button
            android:id="@+id/btnOpenMap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choisir sur la carte"
            android:layout_marginBottom="20dp"/>

        <!-- Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description du problème">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Upload Photo -->
        <Button
            android:id="@+id/btnAddPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajouter une photo"
            android:layout_marginTop="20dp" />

        <!-- Photo Preview Placeholder -->
        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:background="#DDDDDD" />

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Soumettre"
            android:layout_marginTop="24dp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
